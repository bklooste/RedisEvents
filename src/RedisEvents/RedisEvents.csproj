<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Symbolic on a class library (no runtimeconfig.json is emitted here) — documents intent
		     for whatever app ends up hosting this. -->
		<InvariantGlobalization>true</InvariantGlobalization>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<Description>Partitioned, ordered messaging over Redis Streams: per-key ordering, at-least-once delivery with an explicit error contract, outbox/exactly-once publish, and durable consumer positions.</Description>
		<PackageTags>redis;redis-streams;messaging;event-driven;outbox</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="StackExchange.Redis" Version="2.10.1" />
		<!-- Pinned explicitly: both StackExchange.Redis 2.10.1 and Microsoft.SourceLink.GitHub pull in
		     System.IO.Hashing transitively (the latter needs >=10.0.12); leaving it unpinned let NuGet
		     resolve a version too low for one of them, causing a runtime FileNotFoundException. -->
		<PackageReference Include="System.IO.Hashing" Version="10.0.12" />
		<PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
		<!--
		  R-25: these three replace <FrameworkReference Include="Microsoft.AspNetCore.App" />, which
		  used to supply them. Core needs hosting, logging and the source-generated configuration
		  binder; it must NOT need ASP.NET Core, so that a headless worker can reference it alone.
		  The ASP.NET surface (admin endpoints, health check) lives in RedisEvents.Web, and
		  tst/RedisEvents.HeadlessSmoke is the regression guard that keeps it out of here.
		-->
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="RedisEvents.Web" />
		<InternalsVisibleTo Include="RedisEvents.UnitTests" />
		<InternalsVisibleTo Include="RedisEvents.Tests" />
		<!-- RedisEvents.TestSupport's RedisStreamsFixture drives instances via the internal OwnershipRegistry. -->
		<InternalsVisibleTo Include="RedisEvents.TestSupport" />
		<!-- MessagePackRegistrationTests asserts against the internal StreamRegistry. -->
		<InternalsVisibleTo Include="RedisEvents.MessagePack.UnitTests" />
		<!-- EventRepositoryTests/EventSourcingEndToEndTests/EventSourcingPerfBenchmarkTests reach
		     StreamKeys/StreamStore/EntryCodec/RedisPositionStore directly. -->
		<InternalsVisibleTo Include="RedisEvents.EventSourcing.Tests" />
		<!--
		  R-23: the headless guard asserts the container built exactly one StreamConsumerHost, which
		  is internal wiring after the public-surface trim. It is a test project, not a consumer.
		-->
		<InternalsVisibleTo Include="RedisEvents.HeadlessSmoke" />
	</ItemGroup>

</Project>
