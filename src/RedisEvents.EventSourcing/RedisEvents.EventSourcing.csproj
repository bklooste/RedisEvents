<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<Description>Event-sourced aggregates over RedisEvents: per-aggregate Redis streams as the source of truth, optimistic concurrency, and reflection-free event dispatch. Typed projections/view stores live in the sibling RedisEvents.Projections package, usable independently of this one.</Description>
		<PackageTags>redis;redis-streams;event-sourcing;cqrs</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../RedisEvents/RedisEvents.csproj" />
		<!-- For EventTypeRegistry: the write side and the read side (RedisEvents.Projections) share
		     one registry per topic, so an aggregate's events and its projections never disagree on
		     wire format. This is the one-way dependency: Projections does not reference this
		     package, so it stays usable with no event-sourced write side at all. -->
		<ProjectReference Include="../RedisEvents.Projections/RedisEvents.Projections.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Same version core pins; used directly by EventSourcingOpenTelemetryExtensions rather than
		     relying on the transitive reference through RedisEvents. -->
		<PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="RedisEvents.EventSourcing.UnitTests" />
		<InternalsVisibleTo Include="RedisEvents.EventSourcing.Tests" />
	</ItemGroup>

</Project>
