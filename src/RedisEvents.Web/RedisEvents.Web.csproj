<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  R-25 (headless split). Everything in RedisEvents that needs ASP.NET Core lives here (the
	  admin endpoints), so a worker with no web host can reference RedisEvents alone. The health
	  check is host-neutral and lives in RedisEvents.HealthChecks. The regression guard for that is tst/RedisEvents.HeadlessSmoke.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<Description>Minimal-API admin endpoints for RedisEvents (and, by reference, the RedisEvents.HealthChecks stream health check), kept separate so a headless worker can reference the core library without pulling in ASP.NET Core.</Description>
		<PackageTags>redis;redis-streams;messaging;aspnetcore;health-checks</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../RedisEvents/RedisEvents.csproj" />
		<!-- The health check moved to the ASP.NET-free RedisEvents.HealthChecks; referenced so a web service still gets it from this package. -->
		<ProjectReference Include="../RedisEvents.HealthChecks/RedisEvents.HealthChecks.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="RedisEvents.UnitTests" />
		<InternalsVisibleTo Include="RedisEvents.Tests" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

</Project>
