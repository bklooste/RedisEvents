<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <NoWarn>xUnit1051</NoWarn>
  </PropertyGroup>

  <!--
    Service-level tests only: both sample services hosted for real, in-process, over a real
    Testcontainers Redis, talked to purely over HTTP. The library's own correctness coverage lives in
    RedisEvents.EventSourcing.UnitTests and RedisEvents.EventSourcing.Tests — this project does not
    repeat it.
  -->
  <ItemGroup>
    <PackageReference Include="Testcontainers" Version="4.15.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
    <PackageReference Include="xunit.v3" Version="1.0.0" />
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedisEvents.TestSupport\RedisEvents.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\RedisEvents\RedisEvents.csproj" />
    <ProjectReference Include="..\..\src\RedisEvents.EventSourcing\RedisEvents.EventSourcing.csproj" />
    <ProjectReference Include="..\..\samples\RedisEvents.EventSourcing.Sample.Inventory\RedisEvents.EventSourcing.Sample.Inventory.csproj" />
    <!--
      Both services' entry points are a top-level-statement `Program`, so referencing both
      unaliased would make `Program` an ambiguous CS0433 reference in this project. Each
      ProjectReference gets its own extern alias instead of the implicit "global" one; see the
      `extern alias` directives at the top of ServiceTestHosts.cs.
    -->
    <ProjectReference Include="..\..\samples\RedisEvents.EventSourcing.Sample.Inventory.CommandApi\RedisEvents.EventSourcing.Sample.Inventory.CommandApi.csproj" Aliases="CommandApi" />
    <ProjectReference Include="..\..\samples\RedisEvents.EventSourcing.Sample.Inventory.ViewApi\RedisEvents.EventSourcing.Sample.Inventory.ViewApi.csproj" Aliases="ViewApi" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
